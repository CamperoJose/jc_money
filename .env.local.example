# Copia este archivo a `.env.local` y rellena con valores reales.
# `.env.local` está ignorado por git — NUNCA subas credenciales reales al repo.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side, secreta

# --- Auth ---
# No hay whitelist: cualquier usuario autenticado con Google puede entrar.

# --- API para máquinas (ingesta, respaldos, recordatorios) ---
API_BEARER_TOKEN=                    # token para rutas protegidas (scheduler/Siri)

# --- Correo SMTP (remitente global de MyMoney) ---
SMTP_USER=                            # Gmail que envía los correos
SMTP_PASS=                            # App Password de Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_TO=                              # fallback de compatibilidad; multiusuario usa email_destino

# --- IA / voz ---
GEMINI_API_KEY=                       # compatibilidad; la implementación actual usa Vertex AI
GCP_SA_JSON=                          # JSON o base64 del service account (server-side)
GCP_LOCATION=global                   # ubicación de Vertex AI
GEMINI_MODEL=gemini-2.5-flash-lite
STT_LOCATION=global                   # ubicación de Cloud Speech-to-Text
STT_MODEL=latest_short                # modelo para comandos de voz cortos

# --- IA / respaldos ---
GMAIL_USER=                           # compatibilidad con integraciones existentes
GMAIL_APP_PASSWORD=                   # compatibilidad con integraciones existentes
GOOGLE_DRIVE_FOLDER_ID=               # carpeta destino de respaldos
GOOGLE_SERVICE_ACCOUNT_JSON=          # ruta o contenido del JSON del service account
