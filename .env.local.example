# Copia este archivo a `.env.local` y rellena con valores reales.
# `.env.local` está ignorado por git — NUNCA subas credenciales reales al repo.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side, secreta

# --- Auth ---
ALLOWED_EMAIL=jcampero124@gmail.com  # lista blanca: uno o varios correos separados por coma (ej: a@x.com,b@y.com)

# --- API para máquinas (ingesta, respaldos, recordatorios) ---
API_BEARER_TOKEN=                    # token para rutas protegidas (scheduler/Siri)

# --- Fase 2 ---
GEMINI_API_KEY=                      # voz -> JSON
GMAIL_USER=                          # correo emisor
GMAIL_APP_PASSWORD=                  # app password de 16 caracteres
GOOGLE_DRIVE_FOLDER_ID=              # carpeta destino de respaldos
GOOGLE_SERVICE_ACCOUNT_JSON=         # ruta o contenido del JSON del service account
